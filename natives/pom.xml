<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.ghosthack</groupId>
    <artifactId>libmagic-ffm-parent</artifactId>
    <version>5.48-0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>libmagic-ffm-natives</artifactId>
  <packaging>pom</packaging>
  <name>libmagic-ffm natives</name>
  <description>From-source libmagic shared library and compiled magic database</description>
  <licenses>
    <license>
      <name>BSD 2-Clause License</name>
      <url>https://opensource.org/license/bsd-2-clause</url>
      <distribution>repo</distribution>
    </license>
    <license>
      <name>GNU Lesser General Public License v2.1 or later</name>
      <url>https://www.gnu.org/licenses/old-licenses/lgpl-2.1.html</url>
      <distribution>repo</distribution>
      <comments>Applies to the libintl and libiconv support DLLs in the Windows classifier.</comments>
    </license>
  </licenses>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <executions>
          <execution>
            <id>natives-jar</id>
            <phase>package</phase>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classesDirectory>src/main/resources</classesDirectory>
              <classifier>${native.classifier}</classifier>
              <includes><include>natives/${native.classifier}/**</include></includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>all-natives</id>
      <properties><native.classifier>macos-arm64</native.classifier></properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <version>3.4.2</version>
            <executions>
              <execution>
                <id>natives-jar-windows</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classesDirectory>src/main/resources</classesDirectory>
                  <classifier>windows-x64</classifier>
                  <includes><include>natives/windows-x64/**</include></includes>
                </configuration>
              </execution>
              <execution>
                <id>natives-jar-linux</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classesDirectory>src/main/resources</classesDirectory>
                  <classifier>linux-x64</classifier>
                  <includes><include>natives/linux-x64/**</include></includes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
